{
	"name": "verdant",
	"private": true,
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev",
		"lint": "turbo lint",
		"format": "prettier --write \"**/*.{js,ts,tsx,md,json}\"",
		"prepare": "husky",
		"test": "turbo run test"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^9.39.0",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"jest": "^30.5.1",
		"lint-staged": "^17.5.0",
		"prettier": "^3.9.6",
		"turbo": "^2.10.12"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"eslint --fix"
		]
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged",
			"commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
		}
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "npm@12.0.2",
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
